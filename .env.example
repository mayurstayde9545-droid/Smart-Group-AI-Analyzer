# Copy this file to .env, then replace the example passwords before starting Docker.
DB_USER=smartgroup
DB_PASSWORD=replace-this-with-a-private-password
DB_ROOT_PASSWORD=replace-this-with-a-different-private-password

# Optional: for compose.host-db.yaml, use the MySQL Server already running on this PC.
# Set DB_USER and DB_PASSWORD above to a dedicated MySQL application user's credentials.
DB_URL=jdbc:mysql://host.docker.internal:3306/smartgroup?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
